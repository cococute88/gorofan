# Store actual values OUTSIDE the checkout at /etc/gorofan/gorofan.env, mode 600.
# Replace the placeholder with secrets.token_hex(32); never use it as a key.
APP_SECRET_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
APP_ENV=prod
AUTH_ENABLED=false
# No Gemini credential is needed to start. Do not add test/sentinel credentials.
